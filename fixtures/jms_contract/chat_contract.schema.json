     "created_at": {
      "anyOf": [
       {
        "type": "string"
       },
       {
        "type": "null"
       }
      ],
      "default": null,
      "description": "UTC timestamp when stored (ISO 8601 with milliseconds and Z). Present when persisted.",
      "title": "Created At"
     }
