# Required: the database to report on. Use a read-only user.
REPORTSBOT_DATABASE_URL=mysql+pymysql://reports_ro:reports_ro@127.0.0.1:3307/jms
# Required for chat and for `bootstrap --describe`.
REPORTSBOT_OPENROUTER_API_KEY=
# Optional (defaults shown).
# REPORTSBOT_MODEL=anthropic/claude-sonnet-5.5
# REPORTSBOT_FAST_MODEL=anthropic/claude-haiku-5.5
# REPORTSBOT_STATE_DIR=data
# REPORTSBOT_ROW_LIMIT=500
# REPORTSBOT_QUERY_TIMEOUT_S=30
# REPORTSBOT_ALLOW_TABLES=
# REPORTSBOT_DENY_COLUMNS=
# REPORTSBOT_SHARE_THRESHOLD=3
